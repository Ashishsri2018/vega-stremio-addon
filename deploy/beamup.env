# Non-secret Beamup runtime configuration.
# Reapplied by CI after each deploy; keep secret values in BEAMUP_EXTRA_ENV.
LOG_LEVEL=info
INCLUDE_MAGNETS=false
PROXY_ENABLED=false
UPDATE_ON_START=true
UPDATE_INTERVAL_MIN_HOURS=4
UPDATE_INTERVAL_MAX_HOURS=6
SETTLE_MS=4000
EMPTY_FENCE_MS=0
SEARCH_CONCURRENCY=40
SEARCH_TIMEOUT_MS=5000
META_TIMEOUT_MS=8000
STREAM_TIMEOUT_MS=8000
GLOBAL_DEADLINE_MS=10000
DISABLED_PROVIDERS=torrentio,internetArchive,youtube
